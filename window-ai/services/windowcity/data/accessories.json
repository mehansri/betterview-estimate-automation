 "mullion_reinforcement": {
  "description": "Book 64-65 (pdf 68-69, read from the rendered pages): combination windows use steel-reinforced PVC mullions once the overall unit crosses both printed thresholds. 1\" mullion (EP-155 for 3 1/4\" frame, EP-455 for 4 1/2\") reinforces vertical joints; 2\" mullion (EP-156 / EP-456) reinforces horizontal joints.",
  "profiles": {
   "vertical": {
    "3.25": "EP-155",
    "4.5": "EP-455"
   },
   "horizontal": {
    "3.25": "EP-156",
    "4.5": "EP-456"
   }
  },
  "rules": [
   {
    "config": "stack of 2-3 units (1 wide), or shape over unit",
    "trigger": "height > 66 and width > 72",
    "reinforce": "horizontal joints"
   },
   {
    "config": "2 units side by side",
    "trigger": "height > 66 and width > 72",
    "reinforce": "vertical joint"
   },
   {
    "config": "3 units side by side",
    "trigger": "height > 66 and width > 108",
    "reinforce": "vertical joints"
   },
   {
    "config": "2x2 grid, or shape over 2 wide",
    "trigger": "height > 66 and width > 72",
    "reinforce": "vertical and horizontal joints"
   },
   {
    "config": "2x3 or 3x3 grid",
    "trigger": "height > 66 and width > 108",
    "reinforce": "vertical and horizontal joints"
   }
  ]
 },
 "notes": {
  "couplers": "Combination unit price includes the 0-degree coupler at no additional charge (book 29).",
  "brickmould": "All brickmould comes without fin unless specified; J-channel available on all except 4\" at same price (book 28)."
 }
