# Database
DATABASE_URL=postgresql://windowai:windowai@localhost:5432/windowai
POSTGRES_USER=windowai
POSTGRES_PASSWORD=windowai
POSTGRES_DB=windowai

# API
API_HOST=0.0.0.0
API_PORT=8000
MODEL_PATH=models/quote_predictor.joblib
FEATURE_SCHEMA_PATH=models/feature_schema.json
METRICS_PATH=models/metrics.json
CURRENCY=CAD
# Required for manager-only sales preset edits and floor overrides.
PRICING_ADMIN_TOKEN=change-this-manager-token
# Required on Vercel: every route except /health needs "Authorization: Bearer <this>".
# The frontend (API_ACCESS_TOKEN) and the CRM (ESTIMATOR_API_TOKEN) use the same value.
API_ACCESS_TOKEN=

# Training
SYNTHETIC_N_ESTIMATES=400
SYNTHETIC_SEED=42
MAPE_PROMOTE_THRESHOLD=4.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Customer links: public origin of the app, used when a request doesn't say
# (e.g. https://estimates.betterview.ca). The app normally sends its own origin.
PUBLIC_APP_URL=
# Restrict browser CORS to the app's origin(s), comma-separated. Unset = "*".
ALLOWED_ORIGINS=

# Email for sending estimates (any SMTP provider). Leave SMTP_HOST empty to
# disable email: salespeople then get a link to send from their own mail app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Better View Solutions <estimates@betterview.ca>
# true for implicit TLS (usually port 465); otherwise STARTTLS is used
SMTP_USE_SSL=false

# Optional AI follow-up email drafts (Claude). Unset = plain template drafts.
ANTHROPIC_API_KEY=
# Set to "off" to always use the template even when a key is present.
FOLLOW_UP_AI=
