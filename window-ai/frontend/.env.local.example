# Backend target for Next.js rewrites (server-side only)
API_PROXY_URL=http://localhost:8000

# Server-side Google Places API key for customer address autocomplete.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Access control (see middleware.ts). Leave both unset for local development.
# API_ACCESS_TOKEN is required in production and must equal the API project's
# API_ACCESS_TOKEN and the CRM's ESTIMATOR_API_TOKEN. ESTIMATOR_ACCESS_PASSWORD
# is optional: set it to make people sign in (browser prompt) before using the site.
# ESTIMATOR_ACCESS_PASSWORD=
# API_ACCESS_TOKEN=

# Supabase browser/SSR client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Better View CRM base URL for the project page "Send to CRM" button (opens
# <CRM>/estimates/import?source=estimator&project=<id> in a new tab). Leave unset
# to hide the button. Local sandbox CRM: http://localhost:3100
NEXT_PUBLIC_CRM_URL=http://localhost:3100
