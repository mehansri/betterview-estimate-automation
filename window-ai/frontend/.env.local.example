# Backend target for Next.js rewrites (server-side only)
API_PROXY_URL=http://localhost:8000

# Server-side Google Places API key for customer address autocomplete.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Leave unset so the browser uses same-origin /api/* (proxied).
# Only set this if you want the browser to call the API directly:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase browser/SSR client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
